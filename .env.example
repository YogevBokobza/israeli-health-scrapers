# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Credentials, per fund -------------------------------------------------
# Prefix is IHS_<FUND>_. The ID is the Israeli ID number (תעודת זהות).
# Leave the password unset for an account that logs in with an SMS code only.
IHS_MACCABI_ID=
IHS_MACCABI_PASSWORD=

# --- Session storage -------------------------------------------------------
# Encrypts the stored login session (AES-256-GCM). Without it, no session is kept
# and an OTP account will ask for a new SMS on every single run.
# Generate with: openssl rand -base64 32
IHS_SESSION_KEY=

# --- Permissions -----------------------------------------------------------
# Hard kill switch. `readonly` blocks every write operation regardless of the
# policy file. Unset it only when you actually want writes enabled.
IHS_MODE=readonly

# Which profile from health.policy.json to apply.
IHS_PROFILE=readonly

# Comma-separated funds to enable. Only maccabi is implemented today.
IHS_FUNDS=maccabi

# --- Optional --------------------------------------------------------------
# IHS_DATA_DIR=./data
# IHS_SESSION_TTL_HOURS=12
# IHS_LOG_LEVEL=info
# IHS_AUDIT=off
# IHS_DIAGNOSTICS=off
# Point at a Chromium build when the pinned Playwright one is not installed.
# IHS_CHROMIUM_PATH=/opt/pw-browsers/chromium
