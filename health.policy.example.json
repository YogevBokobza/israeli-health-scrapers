{
  "defaultProfile": "readonly",
  "profiles": {
    "readonly": {
      "scopes": ["*:*:read"],
      "requireConfirmation": [],
      "rateLimits": {}
    },

    "assistant": {
      "scopes": [
        "maccabi:medications:read",
        "maccabi:appointments:read",
        "maccabi:appointments:write",
        "maccabi:messages:write"
      ],
      "requireConfirmation": ["*:*:write"],
      "rateLimits": {
        "*:*:write": { "perHour": 5 }
      }
    },

    "medications-only": {
      "scopes": ["maccabi:medications:read"],
      "requireConfirmation": [],
      "rateLimits": {}
    }
  }
}
